{
	"info": {
		"_postman_id": "a9e8ecdb-6248-4a2c-9749-a2cf8034e127",
		"name": "poc-spring-webflux",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"description": "Run the requests top to bottom. The login requests store the JWTs in the collection variables {{jwt}} (rider) and {{driverJwt}} (driver); create/propose store {{rideRequestId}} and {{rideProposalId}}."
	},
	"item": [
		{
			"name": "[USER] register",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"rider-{{runId}}@example.com\",\n    \"password\": \"rider-password\",\n    \"firstName\": \"Ada\",\n    \"lastName\": \"Lovelace\",\n    \"role\": \"USER\",\n    \"phoneNumber\": \"0600000000\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			},
			"response": [],
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// New example accounts on every run of the collection (emails must be unique).",
							"if (!pm.collectionVariables.get('runId')) { pm.collectionVariables.set('runId', Date.now().toString()); }"
						]
					}
				}
			]
		},
		{
			"name": "[DRIVER] register",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"driver-{{runId}}@example.com\",\n    \"password\": \"driver-password\",\n    \"firstName\": \"Grace\",\n    \"lastName\": \"Hopper\",\n    \"role\": \"DRIVER\",\n    \"phoneNumber\": \"0600000000\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			},
			"response": []
		},
		{
			"name": "[USER] login (sets {{jwt}})",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/users/auth",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"auth"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"rider-{{runId}}@example.com\",\n    \"password\": \"rider-password\",\n    \"role\": \"USER\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('rider logged in', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
							"const value = pm.response.json().token;",
							"pm.collectionVariables.set('jwt', value);",
							"console.log('jwt set');"
						]
					}
				}
			]
		},
		{
			"name": "[DRIVER] login (sets {{driverJwt}})",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/users/auth",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users",
						"auth"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"driver-{{runId}}@example.com\",\n    \"password\": \"driver-password\",\n    \"role\": \"DRIVER\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('driver logged in', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
							"const value = pm.response.json().token;",
							"pm.collectionVariables.set('driverJwt', value);",
							"console.log('driverJwt set');"
						]
					}
				}
			]
		},
		{
			"name": "[USER] create a ride request (sets {{rideRequestId}})",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/rides",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"rides"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n    \"startLng\": 20.2,\n    \"startLat\": 33.2,\n    \"endLng\": 20.1,\n    \"endLat\": 50.1,\n    \"seats\": 2,\n    \"preferredPrice\": 12.22\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwt}}",
							"type": "string"
						}
					]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('ride created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
							"const value = pm.response.json().rideRequestId;",
							"pm.collectionVariables.set('rideRequestId', value);",
							"console.log('rideRequestId set');"
						]
					}
				}
			]
		},
		{
			"name": "[USER] get ride proposals (SSE)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/rides/{{rideRequestId}}/proposals/stream",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"rides",
						"{{rideRequestId}}",
						"proposals",
						"stream"
					]
				},
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwt}}",
							"type": "string"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "[DRIVER] get nearby ride requests (SSE)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/rides/nearby/stream?lat=33.3&lng=20.2&radius=100",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"rides",
						"nearby",
						"stream"
					],
					"query": [
						{
							"key": "lat",
							"value": "33.3"
						},
						{
							"key": "lng",
							"value": "20.2"
						},
						{
							"key": "radius",
							"value": "100"
						}
					]
				},
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{driverJwt}}",
							"type": "string"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "[DRIVER] propose a ride proposal (sets {{rideProposalId}})",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/rides/proposals",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"rides",
						"proposals"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n    \"rideRequestId\": \"{{rideRequestId}}\",\n    \"price\": 15.5\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{driverJwt}}",
							"type": "string"
						}
					]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('offer sent', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
							"const value = pm.response.json().rideProposalId;",
							"pm.collectionVariables.set('rideProposalId', value);",
							"console.log('rideProposalId set');"
						]
					}
				}
			]
		},
		{
			"name": "[USER] accept ride proposal",
			"request": {
				"method": "PUT",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/rides/{{rideRequestId}}/accept",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"rides",
						"{{rideRequestId}}",
						"accept"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n    \"rideProposalId\": \"{{rideProposalId}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwt}}",
							"type": "string"
						}
					]
				}
			},
			"response": []
		}
	],
