# Copy to .env and change the values: cp .env.example .env
# docker compose reads it for the containers; services run from your IDE read it too (spring.config.import).
POSTGRES_USER=ridehailing
POSTGRES_PASSWORD=change-me

# Shared HS512 key: auth-service signs JWTs with it, api-gateway verifies them.
# Required, at least 64 bytes, same value for both services. Generate one with:
#   openssl rand -base64 64 | tr -d '\n'
# (tr removes the line break openssl inserts after 64 characters; the value must be on one line)
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-base64-64
